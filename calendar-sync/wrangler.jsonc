{
  "name": "burgess-calendar-sync",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-27",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  },
  "keep_vars": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
